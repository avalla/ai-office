    { "kind": "feature", "pipelineId": "delivery" },
    { "kind": "bugfix", "pipelineId": "bugfix" },
    { "kind": "maintenance", "pipelineId": "delivery" },
    { "kind": "research", "pipelineId": "discovery" },
    { "kind": "release", "pipelineId": "release" }
  ],
  "pipelines": [
    {
      "id": "bugfix",
      "name": "Bug fix",
      "description": "Reproduce, fix, review, and verify a defect",
      "defaultFor": ["bugfix"],
      "stages": [
        {
          "id": "reproduce",
          "name": "Reproduce",
          "roleId": "qa",
          "objective": "Establish a deterministic failing case",
          "checks": ["The failure is reproduced before implementation"],
          "requiresApproval": false,
          "eligibleAgents": ["qa"]
        },
        {
          "id": "fix",
          "name": "Fix",
          "roleId": "developer",
          "objective": "Correct the root cause and add regression coverage",
          "checks": ["The regression test passes"],
          "requiresApproval": false,
          "eligibleAgents": ["developer"]
        },
        {
          "id": "review",
          "name": "Review",
          "roleId": "reviewer",
          "objective": "Confirm the root cause is addressed without scope creep",
          "checks": ["No unresolved blocking findings remain"],
          "requiresApproval": true,
          "eligibleAgents": ["reviewer"]
        }
      ]
    },
    {
      "id": "delivery",
      "name": "Feature delivery",
      "description": "Plan, implement, review, and verify product changes",
      "defaultFor": ["feature", "maintenance"],
      "enforcement": "enforced",
      "stages": [
        {
          "id": "design",
          "name": "Design",
          "roleId": "architect",
          "objective": "Define the smallest coherent change and its acceptance criteria",
          "checks": ["Dependencies and security boundaries are explicit"],
          "requiresApproval": false,
          "capabilities": [],
          "eligibleAgents": ["architect"]
        },
        {
          "id": "implement",
          "name": "Implement",
          "roleId": "developer",
          "objective": "Implement the agreed change with focused tests",
          "checks": ["Relevant tests pass", "Typecheck passes"],
          "requiresApproval": false,
          "capabilities": [],
          "eligibleAgents": ["developer"]
        },
        {
          "id": "review",
          "name": "Review",
          "roleId": "reviewer",
          "objective": "Review correctness, security, and scope",
          "checks": ["No unresolved blocking findings remain"],
          "requiresApproval": true,
          "capabilities": [],
          "eligibleAgents": ["reviewer"]
        },
        {
          "id": "verify",
          "name": "Verify",
          "roleId": "qa",
          "objective": "Validate acceptance criteria and regression safety",
          "checks": ["Full relevant check suite passes"],
          "requiresApproval": false,
          "capabilities": [],
          "eligibleAgents": ["qa"]
        }
      ]
    },
    {
      "id": "discovery",
      "name": "Research",
      "description": "Investigate a question and record an evidence-based recommendation",
      "defaultFor": ["research"],
      "stages": [
        {
          "id": "investigate",
          "name": "Investigate",
          "roleId": "architect",
          "objective": "Collect relevant evidence and compare viable approaches",
          "checks": ["Recommendation identifies evidence and uncertainty"],
          "requiresApproval": false,
          "eligibleAgents": ["architect"]
        }
      ]
    },
    {
      "id": "release",
      "name": "Release",
      "description": "Review readiness, verify the build, and require a release decision",
      "defaultFor": ["release"],
      "stages": [
        {
          "id": "readiness",
          "name": "Readiness review",
          "roleId": "reviewer",
          "objective": "Confirm scope, risks, and unresolved findings",
          "checks": [
            "Release scope is explicit",
            "Blocking findings are resolved"
          ],
          "requiresApproval": false,
          "eligibleAgents": ["reviewer"]
        },
        {
          "id": "verification",
          "name": "Release verification",
          "roleId": "qa",
          "objective": "Run the release checks and verify artifacts",
          "checks": ["Release check suite passes"],
          "requiresApproval": true,
          "eligibleAgents": ["qa"]
        }
      ]
    }
  ],
