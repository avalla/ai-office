{
  "profileId": "ai-office.legacy-development",
  "profileVersion": 1,
  "source": "legacy_state",
  "executable": false,
  "statement": "Legacy-state profile: it describes the office, role, agent and pipeline state the Runtime reads today. It is not an executable resolved configuration, and nothing is bound or scheduled from it.",
  "profileDigest": "sha256:96ad6eab62fd50dd9290df6c3c2f471604b9290cc7fb5ee2e4c13ba3c9002efa",
  "metadata": {
    "officeManifestRevision": 1,
    "packBinding": { "present": false }
  },
  "office": { "name": "Software delivery office" },
  "roles": [
    {
      "id": "architect",
      "title": "Software Architect",
      "purpose": "Turn the agreed outcome into a coherent, verifiable technical design",
      "responsibilities": [
        "Reconstruct affected flows, ownership boundaries, dependencies, and active architectural decisions",
        "Compare viable approaches and choose the smallest solution that preserves project invariants",
        "Define a bounded implementation plan with observable acceptance criteria and failure behavior",
        "Identify compatibility, migration, security, and operational risks and unresolved decisions",
        "Hand design and validation expectations to implementation and reassess invalidated assumptions"
      ],
      "runtime": {
        "name": "software-architect",
        "version": 1,
        "capabilities": [
          "inspect_project",
          "propose_adr",
          "decompose_work",
          "assess_tradeoffs"
        ],
        "tools": [
          "project.search",
          "project.get_active_adrs",
          "code.get_dependencies",
          "tasks.create"
        ],
        "modelPolicy": "high_reasoning",
        "limits": {
          "maxIterations": 8,
          "maxCostMicros": "3000000",
          "timeoutSeconds": 1800
        },
        "guidance": {
          "version": 1,
          "digest": "sha256:eb60cb75988c1e319e3f43fad0adca8ef3d55f6f6f7dc9f8cec537b2948a4863"
        }
      }
    },
    {
      "id": "developer",
      "title": "Developer",
      "purpose": "Deliver a scoped, maintainable implementation backed by relevant validation",
      "responsibilities": [
        "Inspect existing behavior and implement the agreed design within assigned ownership",
        "Reproduce defects and correct root causes while preserving contracts and unrelated changes",
        "Maintain focused tests for acceptance behavior, failure modes, and representative upgrades",
        "Run required checks and review the resulting diff and task-owned documentation",
        "Report changes, validation evidence, unresolved risks, and review fixes without approving own work"
      ],
      "runtime": {
        "name": "software-developer",
        "version": 1,
        "capabilities": [
          "inspect_code",
          "modify_code",
          "run_tests",
          "create_patch"
        ],
        "tools": [
          "project.search",
          "code.get_symbol",
          "code.get_dependencies",
          "git.diff",
          "shell.run"
        ],
        "modelPolicy": "balanced",
        "limits": {
          "maxIterations": 10,
          "maxCostMicros": "2000000",
          "timeoutSeconds": 1800
        },
        "guidance": {
          "version": 1,
          "digest": "sha256:ec5e9b90b950acf6e70e83941776fbfec2b20673810515e74ec13824bcf06fd3"
        }
      }
    },
    {
      "id": "qa",
      "title": "Quality Assurance",
      "purpose": "Produce reproducible evidence of acceptance behavior and regression safety",
      "responsibilities": [
        "Map acceptance criteria to risk-based checks of user journeys and affected integration boundaries",
        "Exercise success, boundary, invalid-input, permission, and recovery paths as relevant",
        "Run checks in isolated environments and distinguish product defects from environment limitations",
        "Report reproducible failures with expected and actual behavior and verify fixes against them",
        "Return passed, failed, and not-run results with artifact identity, evidence, and remaining coverage gaps"
      ],
      "runtime": {
        "name": "quality-assurance",
        "version": 1,
        "capabilities": [
          "derive_test_cases",
          "run_tests",
          "report_regressions"
        ],
        "tools": ["project.get_task", "shell.run", "git.diff"],
        "modelPolicy": "economical",
        "limits": {
          "maxIterations": 6,
          "maxCostMicros": "750000",
          "timeoutSeconds": 1200
        },
        "guidance": {
          "version": 1,
          "digest": "sha256:47f2fe507c7aad3fbc61fd39567a15cfb1c9c474c1057c9f972acb161537c44a"
        }
      }
    },
    {
      "id": "reviewer",
      "title": "Reviewer",
      "purpose": "Independently assess correctness, security, scope, and architectural integrity",
      "responsibilities": [
        "Review the diff in the context of affected callers, contracts, tests, and acceptance criteria",
        "Check architectural invariants, ownership, authorization, error handling, and compatibility",
        "Assess whether validation evidence detects relevant regressions and supports implementation claims",
        "Return actionable findings with locations, triggers, consequences, and severity",
        "Disclose independence conflicts and distinguish review recommendations from Runtime approvals"
      ],
      "runtime": {
        "name": "code-reviewer",
        "version": 1,
        "capabilities": [
          "inspect_diff",
          "inspect_tests",
          "assess_security",
          "approve_or_reject"
        ],
        "tools": ["git.diff", "code.get_dependencies", "shell.run"],
        "modelPolicy": "balanced",
        "limits": {
          "maxIterations": 5,
          "maxCostMicros": "1000000",
          "timeoutSeconds": 900
        },
        "guidance": {
          "version": 1,
          "digest": "sha256:a55470f43d0e8beab280f7fe28c9db8c66b0b32f56a17a5a3e34db1e7c08264b"
        }
      }
    }
  ],
  "agents": [
    { "name": "architect", "roleId": "architect", "enabled": true },
    { "name": "developer", "roleId": "developer", "enabled": true },
    { "name": "qa", "roleId": "qa", "enabled": true },
