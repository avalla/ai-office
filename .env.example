# Interactive onboarding runs through the host ai-office skill and needs no
# provider credential in AI Office. The variables below are optional and only
# enable the legacy unattended project:onboard fallback.

# OpenAI example:
# AI_OFFICE_LLM_MODEL=openai:gpt-5.4
# OPENAI_API_KEY=

# Anthropic example:
# AI_OFFICE_LLM_MODEL=anthropic:claude-sonnet-4-6
# ANTHROPIC_API_KEY=

# Optional provider diagnostics. Logs request metadata and sanitized errors.
AI_OFFICE_DEBUG_LLM=0
