{
  "schemaVersion": 1,
  "id": "org.ai-office.legal",
  "version": "0.2.0",
  "manifestDigest": "sha256:d089d7654c9c4dfcf752e23d14460e83ac983bd6e352a8b59c0de76a0ad46ff1",
  "coreContract": {
    "minInclusive": 1,
    "maxExclusive": 2
  },
  "metadata": {
    "name": "Legal reference",
    "description": "Declarative matter workflow fixture covering a generic review plus civil, criminal and labor practice areas; it does not offer legal services or run a Runtime pipeline."
  },
  "dependencies": [],
  "contributions": {
    "roles": [
      {
        "id": "intake-clerk",
        "title": "Intake clerk"
      },
      {
        "id": "researcher",
        "title": "Legal researcher",
        "capabilities": ["read-matter"]
      },
      {
        "id": "drafter",
        "title": "Drafting counsel",
        "capabilities": ["read-matter"]
      },
      {
        "id": "reviewer",
        "title": "Review counsel",
        "capabilities": ["read-matter"]
      },
      {
        "id": "approver",
        "title": "Human approver"
      },
      {
        "id": "deadline-clerk",
        "title": "Procedural deadline clerk"
      },
      {
        "id": "conciliator",
        "title": "Conciliation officer"
      }
    ],
    "taskTypes": [
      {
        "id": "matter"
      },
      {
        "id": "civil-matter"
      },
      {
        "id": "criminal-matter"
      },
      {
        "id": "labor-matter"
      }
    ],
    "workflows": [
      {
        "id": "matter-workflow",
        "title": "Matter review",
        "taskType": "matter",
        "stages": [
          {
            "id": "intake",
            "role": "intake-clerk",
            "title": "Intake",
            "objective": "Record the matter request"
          },
          {
            "id": "research",
            "role": "researcher",
            "title": "Research",
            "objective": "Collect sources and citations"
          },
          {
            "id": "draft",
            "role": "drafter",
            "title": "Draft",
            "objective": "Prepare a draft for review"
          },
          {
            "id": "citation-review",
            "role": "reviewer",
            "title": "Citation review",
            "objective": "Check cited support for the draft"
          },
          {
            "id": "human-approval",
            "role": "approver",
            "title": "Human approval",
            "objective": "Decide whether the reviewed draft is approved"
          }
        ]
      },
      {
        "id": "civil-matter-workflow",
        "title": "Civil matter review",
        "taskType": "civil-matter",
        "stages": [
          {
            "id": "intake",
            "role": "intake-clerk",
            "title": "Intake",
            "objective": "Record the civil matter request"
          },
          {
            "id": "research",
            "role": "researcher",
            "title": "Research",
            "objective": "Collect sources and citations for the civil matter"
          },
          {
            "id": "draft",
            "role": "drafter",
            "title": "Draft",
            "objective": "Prepare a civil pleading draft for review"
          },
          {
            "id": "citation-review",
            "role": "reviewer",
            "title": "Citation review",
            "objective": "Check cited support for the draft"
          },
          {
            "id": "filing-approval",
            "role": "approver",
            "title": "Filing approval",
            "objective": "Decide whether the reviewed draft may be filed with the court"
          }
        ]
      },
      {
        "id": "criminal-matter-workflow",
        "title": "Criminal matter review",
        "taskType": "criminal-matter",
        "stages": [
          {
            "id": "intake",
            "role": "intake-clerk",
            "title": "Intake",
            "objective": "Record the criminal matter request"
          },
          {
            "id": "deadline-check",
            "role": "deadline-clerk",
            "title": "Deadline check",
            "objective": "Verify statutory and procedural deadlines before substantive work begins"
          },
          {
            "id": "research",
            "role": "researcher",
            "title": "Research",
            "objective": "Collect sources and citations for the criminal matter"
          },
          {
            "id": "draft",
            "role": "drafter",
            "title": "Draft",
            "objective": "Prepare a criminal defense or filing draft for review"
          },
          {
            "id": "citation-review",
            "role": "reviewer",
            "title": "Citation review",
            "objective": "Check cited support for the draft"
          },
          {
            "id": "human-approval",
            "role": "approver",
            "title": "Human approval",
            "objective": "Decide whether the reviewed draft is approved"
          }
        ]
      },
      {
        "id": "labor-matter-workflow",
        "title": "Labor matter review",
        "taskType": "labor-matter",
        "stages": [
          {
            "id": "intake",
            "role": "intake-clerk",
            "title": "Intake",
            "objective": "Record the labor matter request"
          },
          {
            "id": "conciliation",
            "role": "conciliator",
            "title": "Conciliation",
            "objective": "Record the mandatory conciliation attempt and its outcome before drafting"
          },
          {
            "id": "research",
            "role": "researcher",
            "title": "Research",
            "objective": "Collect sources and citations for the labor matter"
          },
          {
            "id": "draft",
            "role": "drafter",
            "title": "Draft",
            "objective": "Prepare a labor matter draft for review"
          },
          {
            "id": "citation-review",
            "role": "reviewer",
            "title": "Citation review",
            "objective": "Check cited support for the draft"
          },
          {
            "id": "human-approval",
            "role": "approver",
            "title": "Human approval",
            "objective": "Decide whether the reviewed draft is approved"
          }
        ]
      }
    ],
    "agents": [
      {
        "id": "intake-agent",
        "role": "intake-clerk"
      },
      {
        "id": "research-agent",
        "role": "researcher",
        "knowledge": ["matter-research"],
        "capabilities": ["read-matter"]
      },
      {
        "id": "draft-agent",
        "role": "drafter",
        "knowledge": ["matter-research"],
        "capabilities": ["read-matter"]
      },
      {
        "id": "review-agent",
        "role": "reviewer",
        "knowledge": ["matter-research"],
        "capabilities": ["read-matter"]
      },
      {
        "id": "approval-agent",
        "role": "approver"
      },
      {
        "id": "deadline-agent",
        "role": "deadline-clerk"
      },
      {
        "id": "conciliation-agent",
        "role": "conciliator"
      }
    ],
    "artifactTypes": [
      {
        "id": "matter-draft",
        "title": "Matter draft",
        "mediaTypes": ["application/json"],
        "maximumBytes": 65536,
        "contentSchema": {
          "type": "object",
          "properties": {
            "body": {
              "type": "string"
            }
          },
          "required": ["body"]
        }
      },
      {
        "id": "citation-list",
        "title": "Citation list",
        "mediaTypes": ["application/json"],
        "maximumBytes": 65536,
        "contentSchema": {
          "type": "object",
          "properties": {
            "sources": {
              "type": "string"
            }
          },
          "required": ["sources"]
        }
      }
    ],
    "evidenceTypes": [
      {
        "id": "citation-review-evidence",
        "title": "Citation review evidence",
        "subject": "citation-list",
        "payloadSchema": {
          "type": "object",
          "properties": {
            "checkedBy": {
              "type": "string"
            }
          },
          "required": ["checkedBy"]
        }
      },
      {
        "id": "approval-evidence",
        "title": "Human approval evidence",
        "subject": "matter-draft",
        "payloadSchema": {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string"
            }
          },
          "required": ["decision"]
        }
      }
    ],
    "policies": [
      {
        "id": "matter-governance",
        "title": "Matter governance",
        "workflow": "matter-workflow",
        "enforcement": "enforced",
        "stages": [
          {
            "stage": "citation-review",
            "requiresApproval": true,
            "requiresDifferentAgentFrom": ["draft"]
          },
          {
            "stage": "human-approval",
            "requiresApproval": true,
            "requiresIndependentApproval": true,
            "requiresDifferentAgentFrom": ["draft", "citation-review"]
          }
        ]
      },
      {
        "id": "civil-matter-governance",
        "title": "Civil matter governance",
        "workflow": "civil-matter-workflow",
        "enforcement": "enforced",
        "stages": [
          {
            "stage": "citation-review",
            "requiresApproval": true,
            "requiresDifferentAgentFrom": ["draft"]
          },
          {
            "stage": "filing-approval",
            "requiresApproval": true,
            "requiresIndependentApproval": true,
            "requiresDifferentAgentFrom": ["draft", "citation-review"]
          }
        ]
      },
      {
        "id": "criminal-matter-governance",
        "title": "Criminal matter governance",
        "workflow": "criminal-matter-workflow",
        "enforcement": "enforced",
        "stages": [
          {
            "stage": "deadline-check",
            "requiresApproval": true
          },
          {
            "stage": "human-approval",
            "requiresApproval": true,
            "requiresIndependentApproval": true,
            "requiresDifferentAgentFrom": ["draft", "deadline-check"]
          }
        ]
      },
      {
        "id": "labor-matter-governance",
        "title": "Labor matter governance",
        "workflow": "labor-matter-workflow",
        "enforcement": "enforced",
        "stages": [
          {
            "stage": "conciliation",
            "requiresApproval": true
          },
          {
            "stage": "human-approval",
            "requiresApproval": true,
            "requiresDifferentAgentFrom": ["draft"]
          }
        ]
      }
    ],
    "knowledge": [
      {
        "id": "matter-research",
        "title": "Matter research guidance",
        "category": "legal_research",
        "schema": [
          {
            "field": "citation",
            "description": "Source citation supplied for human review."
          },
          {
            "field": "summary",
            "description": "A concise note about the cited source."
          }
        ],
        "retrieval": {
          "maxResults": 5,
          "hint": "Treat retrieved research as unverified until citations are reviewed."
        }
      }
    ],
    "capabilities": [
      {
        "id": "read-matter",
        "operations": [
          {
            "operation": "legal.matter.read",
            "mode": "read"
          }
        ],
        "requirement": "optional"
      }
    ],
    "prompts": [],
    "validators": [
      {
        "id": "citation-checker",
        "title": "Citation checker reference",
        "adapter": {
          "id": "legal.citation-checker",
          "version": "1.0.0"
        },
        "accepts": [
          {
            "kind": "artifactTypes",
            "id": "citation-list"
          }
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "sources": {
              "type": "string"
            }
          },
          "required": ["sources"]
        },
        "produces": "citation-review-evidence",
        "outputSchema": {
          "type": "object",
          "properties": {
            "checkedBy": {
              "type": "string"
            }
          },
          "required": ["checkedBy"]
        },
        "failurePolicy": "fail_closed",
        "timeoutMs": 30000,
        "maxInputBytes": 65536,
        "maxOutputBytes": 65536
      }
    ]
  }
}
