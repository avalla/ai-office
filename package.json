{
  "name": "ai-office",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "bin": {
    "ai-office": "./bin/ai-office.ts"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "daemon": "bun apps/daemon/src/main.ts",
    "dev:daemon": "bun --watch apps/daemon/src/main.ts",
    "cli": "bun apps/cli/src/main.ts",
    "dev:cli": "bun apps/cli/src/main.ts",
    "ai-office": "bun bin/ai-office.ts",
    "db:migrate": "bun scripts/migrate.ts",
    "check": "bun run validate:skills && bun run skills:validate && bun run typecheck && bun run lint && bun run test",
    "smoke:bun-link": "bun scripts/smoke-bun-link.ts",
    "validate:launchd-plists": "bun scripts/validate-launchd-plists.ts",
    "validate:skills": "bun scripts/validate-skills.ts",
    "skills:install": "bun scripts/skills/install.ts",
    "skills:check": "bun scripts/skills/install.ts --check",
    "skills:validate": "bun scripts/skills/validate.ts",
    "test": "bunx --bun vitest run",
    "dashboard:styles": "bunx tailwindcss -c apps/dashboard/tailwind.config.cjs -i apps/dashboard/src/assets/styles.input.css -o apps/dashboard/src/assets/styles.css --minify",
    "test:service-management": "bunx --bun vitest run tests/unit/launchd-user-service-manager.test.ts tests/unit/systemd-user-service-manager.test.ts tests/unit/office-service-management.test.ts tests/unit/service-command-runner.test.ts tests/e2e/service-cli.test.ts",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit",
    "lint": "bunx eslint .",
    "format": "bunx prettier --write ."
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^3.4",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.6"
  }
}
